    "fastify": "^5",
    "pino": "^9",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@recourse/merchant-sdk": "workspace:^",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "express": "^5",
    "vitest": "^2.1.8"
